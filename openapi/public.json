  "info": {
    "contact": {
      "email": "support@crawlora.net",
      "name": "API Support",
      "url": "https://crawlora.net"
    },
    "description": "Crawlora is a hosted web-data and SERP API: call documented REST endpoints and get normalized JSON instead of HTML to parse — across search/SERP, maps and local, e-commerce, app stores, social, media and finance. One API key; Crawlora runs the proxy rotation, headless browsers and parsing behind the scenes. Billed pay-on-success: charged only on a successful 2xx response, 1-10 credits per call, with a free tier of 2,000 credits per month and no card. A hosted MCP server (mcp.crawlora.net/mcp) exposes the same catalog as agent tools. Search endpoints accept `q` as a universal alias for whichever search-term parameter they document (`query`, `term`, `keyword`, or Amazon's `k`), so one parameter name works across the whole catalog; an explicitly supplied documented name always wins.",
    "license": {
      "name": "Crawlora Terms of Service",
      "url": "https://crawlora.net/terms"
    },
    "termsOfService": "https://crawlora.net/terms",
    "title": "Crawlora API",
    "version": "1.2",
    "x-logo": {
      "altText": "Crawlora",
      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/wattpad/categories": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns Wattpad's story categories (Romance, Fantasy, Fanfiction, Werewolf, ...) with id, name and English name. These ids are the values the category parameter of wattpad-search takes and the values in every story's category_ids. The list is read live from Wattpad.",
        "operationId": "wattpad-categories",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wattpad.categoriesResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "List Wattpad story categories",
        "tags": [
          "wattpad"
        ]
      }
    },
    "/wattpad/languages": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns the story languages Wattpad's search can filter by, each with its numeric id and native-script name (50 at the time of writing). These ids are the values the language parameter of wattpad-search takes.",
        "operationId": "wattpad-languages",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wattpad.languagesResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "List Wattpad story languages",
        "tags": [
          "wattpad"
        ]
      }
    },
    "/wattpad/part": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one Wattpad chapter's metadata: id, title, link, word count, reads, votes, comments, length, dates and the story it belongs to (id and title). part_id is the numeric chapter id from wattpad-story-parts. A chapter that does not exist returns not found. Chapter text is never returned.",
        "operationId": "wattpad-part",
        "parameters": [
          {
            "description": "Numeric chapter id from the id field of wattpad-story-parts",
            "in": "query",
            "name": "part_id",
            "required": true,
            "type": "string",
            "x-example": "1353317758"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wattpad.partResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get a Wattpad chapter",
        "tags": [
          "wattpad"
        ]
      }
    },
    "/wattpad/part-comments": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns one page of the public reader comments on a Wattpad chapter, newest first: id, text, commenter username and avatar, reply count, whether it is a reply, parent id, link and creation time. part_id is the numeric chapter id from wattpad-story-parts. limit is 1 to 100 (default 20) and offset pages the list; next_offset is absent on the last page. A chapter with no comments, or an unknown chapter, returns an empty list.",
        "operationId": "wattpad-part-comments",
        "parameters": [
          {
            "description": "Numeric chapter id from the id field of wattpad-story-parts",
            "in": "query",
            "name": "part_id",
            "required": true,
            "type": "string",
            "x-example": "1353317758"
          },
          {
            "description": "Page size, 1 to 100; defaults to 20",
            "in": "query",
            "name": "limit",
            "type": "integer",
            "x-example": 5
          },
          {
            "description": "Zero-based result offset, below 100000; defaults to 0",
            "in": "query",
            "name": "offset",
            "type": "integer",
            "x-example": 0
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/wattpad.partCommentsResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
