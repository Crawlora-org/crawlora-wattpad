{
  "name": "@crawlora-org/wattpad",
  "version": "0.1.0",
  "description": "Crawlora Wattpad API client with 11 endpoints for story, author, search, category, language, and public comment data",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=wattpad-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-wattpad/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "wattpad", "wattpad-api", "wattpad-scraper", "wattpad-data", "wattpad-story", "wattpad-author", "wattpad-search", "wattpad-category", "wattpad-language", "wattpad-public-comment-data"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-wattpad",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
