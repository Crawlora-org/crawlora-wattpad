{
  "name": "crawlora/wattpad",
  "description": "Crawlora Wattpad API client with 11 endpoints for story, author, search, category, language, and public comment data",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "wattpad",
    "wattpad-api",
    "wattpad-scraper",
    "wattpad-data",
    "wattpad-story",
    "wattpad-author",
    "wattpad-search",
    "wattpad-category",
    "wattpad-language",
    "wattpad-public-comment-data"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Wattpad\\": "php/src/Crawlora/Wattpad/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Wattpad\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=wattpad-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-wattpad",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=wattpad-php-api-docs"
  }
}
